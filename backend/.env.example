# =============================================================================
# RecoverX Backend Environment Configuration (Production & Cloud Staging)
#
# IMPORTANT:
# NEVER commit real production secrets into version control.
# In Cloud Staging (e.g. Render), configure these variables via the Dashboard.
# =============================================================================

ENVIRONMENT=production
DATABASE_URL=postgresql+psycopg2://<user>:<password>@<host>:5432/<dbname>?sslmode=require
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=30
DB_POOL_TIMEOUT=30.0
DB_POOL_RECYCLE=1800

# Distributed Redis Rate Limiting
RATE_LIMIT_BACKEND=redis
REDIS_URL=redis://<user>:<password>@<host>:6379/0
RATE_LIMIT_PER_MINUTE=120

# Cloud Object Storage (S3-compatible: AWS S3, Cloudflare R2, MinIO)
OBJECT_STORAGE_PROVIDER=s3
S3_BUCKET=recoverx-production-documents
S3_REGION=us-east-1
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=your_s3_access_key_id
S3_SECRET_ACCESS_KEY=your_s3_secret_access_key

# Authentication & Security
JWT_SECRET=your_super_secret_jwt_key_at_least_32_bytes_long
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Razorpay Credentials (TEST mode during staging / LIVE mode at cutover)
RAZORPAY_KEY_ID=rzp_test_YourTestKeyIdHere
RAZORPAY_KEY_SECRET=YourTestKeySecretHere
RAZORPAY_WEBHOOK_SECRET=YourWebhookSecretHere
WEBHOOK_TOLERANCE_SECONDS=300

# Document Security
DOCUMENT_DOWNLOAD_SECRET=your_document_hmac_secret_key_32b
DOCUMENT_RETENTION_DAYS=90

# High Value Thresholds (ISO-4217 Currency Defaults)
HIGH_VALUE_THRESHOLD_INR=100000
HIGH_VALUE_THRESHOLD_USD=10000

# Settlement Sync & Reconciliation
SETTLEMENT_SYNC_ENABLED=true
SETTLEMENT_SYNC_INTERVAL_SECONDS=300
SETTLEMENT_SYNC_LOOKBACK_HOURS=72
SETTLEMENT_SYNC_BATCH_SIZE=20
RECONCILIATION_VARIANCE_THRESHOLD=10.00

# CORS (Restricted to explicit deployed frontend domain, no wildcard '*')
CORS_ORIGINS=https://recoverx.vercel.app

# AI Integration (Optional)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
