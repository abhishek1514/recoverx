# =========================================================================
# RecoverX Backend Environment Configuration Template (.env.example)
# =========================================================================

APP_NAME=RecoverX API
ENVIRONMENT=development
PORT=8000
LOG_LEVEL=INFO

DATABASE_URL=sqlite:///./recoverx.db
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

JWT_SECRET=your_super_secret_jwt_key_minimum_32_characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
DOCUMENT_DOWNLOAD_SECRET=your_document_signing_secret_32_chars

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here
WEBHOOK_TOLERANCE_SECONDS=300

OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

HIGH_VALUE_THRESHOLD_INR=100000
HIGH_VALUE_THRESHOLD_USD=10000
DOCUMENT_RETENTION_DAYS=90
RATE_LIMIT_PER_MINUTE=120
