# =============================================================================
# RecoverX Backend Environment Configuration (Production & Cloud Staging)
#
# IMPORTANT:
# NEVER commit real production secrets into version control.
# In Cloud Staging (e.g. Render), configure these variables via the Dashboard.
# =============================================================================

ENVIRONMENT=staging
DATABASE_URL=postgresql+psycopg2://<user>:<password>@<host>:5432/<dbname>?sslmode=require
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=30

# Authentication & Security
JWT_SECRET=your_super_secret_jwt_key_at_least_32_bytes_long
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Razorpay TEST Mode Credentials ONLY
RAZORPAY_KEY_ID=rzp_test_YourTestKeyIdHere
RAZORPAY_KEY_SECRET=YourTestKeySecretHere
RAZORPAY_WEBHOOK_SECRET=YourWebhookSecretHere
WEBHOOK_TOLERANCE_SECONDS=300

# Document Security
DOCUMENT_DOWNLOAD_SECRET=your_document_hmac_secret_key_32b
DOCUMENT_RETENTION_DAYS=90

# Rate Limiting (Single Instance)
RATE_LIMIT_PER_MINUTE=120

# High Value Thresholds (ISO-4217 Currency Defaults)
HIGH_VALUE_THRESHOLD_INR=100000
HIGH_VALUE_THRESHOLD_USD=10000

# Settlement Sync & Reconciliation
SETTLEMENT_SYNC_ENABLED=true
SETTLEMENT_SYNC_INTERVAL_SECONDS=300
SETTLEMENT_SYNC_LOOKBACK_HOURS=72
SETTLEMENT_SYNC_BATCH_SIZE=20
RECONCILIATION_VARIANCE_THRESHOLD=10.00

# CORS (Restricted to deployed frontend domain)
CORS_ORIGINS=["https://recoverx-frontend.onrender.com","https://recoverx.vercel.app"]

# AI Integration (Optional)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
