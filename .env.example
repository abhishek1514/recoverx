# =========================================================================
# RecoverX Environment Configuration Template (.env.example)
#
# IMPORTANT SECURITY RULE:
# This file contains variable NAMES and documentation only.
# NEVER place real API keys, secrets, or passwords into this file.
# Copy this file to .env locally and supply your credentials securely.
# =========================================================================

# Application Runtime
APP_NAME=RecoverX API
ENVIRONMENT=development               # development | staging | production
PORT=8000
LOG_LEVEL=INFO                        # DEBUG | INFO | WARNING | ERROR

# Database Configuration (PostgreSQL in production, SQLite in local dev)
DATABASE_URL=postgresql://user:password@localhost:5432/recoverx_db
# For local development with SQLite:
# DATABASE_URL=sqlite:///./recoverx.db
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=30
DB_POOL_TIMEOUT=30.0
DB_POOL_RECYCLE=1800

# Redis & Rate Limiting
RATE_LIMIT_BACKEND=redis              # redis (production) | memory (development)
REDIS_URL=redis://localhost:6379/0
RATE_LIMIT_PER_MINUTE=120             # API sliding window rate limit per IP

# Cloud Object Storage (S3-compatible: AWS S3, Cloudflare R2, MinIO, Wasabi)
OBJECT_STORAGE_PROVIDER=s3           # s3 (production) | local (development)
S3_BUCKET=your-production-documents-bucket
S3_REGION=us-east-1
S3_ENDPOINT_URL=                      # Optional: for MinIO or Cloudflare R2
S3_ACCESS_KEY_ID=your_s3_access_key_id
S3_SECRET_ACCESS_KEY=your_s3_secret_access_key

# JWT & Security Authentication
JWT_SECRET=your_super_secret_jwt_key_minimum_32_characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
DOCUMENT_DOWNLOAD_SECRET=your_document_signing_secret_32_chars
DOCUMENT_RETENTION_DAYS=90            # Automatic document retention lifecycle

# CORS Allowed Origins (Comma-separated exact URLs, no wildcards in production)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://your-frontend.vercel.app

# Razorpay Gateway Integration (TEST MODE Default / LIVE MODE Cutover)
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here
WEBHOOK_TOLERANCE_SECONDS=300         # Replay attack protection window in seconds

# OpenAI API Configuration (Optional - for executive AI summaries)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Business Risk Review Thresholds (Application-configured defaults)
HIGH_VALUE_THRESHOLD=100000           # Default threshold in base units (e.g. INR 1,00,000)
HIGH_VALUE_THRESHOLD_INR=100000
HIGH_VALUE_THRESHOLD_USD=10000
HIGH_VALUE_THRESHOLD_EUR=10000
HIGH_VALUE_THRESHOLD_GBP=10000
HIGH_VALUE_THRESHOLD_SGD=15000
HIGH_VALUE_THRESHOLD_AUD=15000
HIGH_VALUE_THRESHOLD_CAD=15000

# Settlement Sync & Reconciliation
SETTLEMENT_SYNC_ENABLED=true
SETTLEMENT_SYNC_INTERVAL_SECONDS=300
SETTLEMENT_SYNC_LOOKBACK_HOURS=72
SETTLEMENT_SYNC_BATCH_SIZE=20
RECONCILIATION_VARIANCE_THRESHOLD=10.00

# Frontend Environment (Used by Vite during build)
# VITE_API_BASE_URL=https://your-backend-api.onrender.com
